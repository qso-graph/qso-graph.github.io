---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---
<script is:inline>
  try {
    if (localStorage.getItem('qso-navigation-collapsed') === 'true') document.documentElement.dataset.navigationCollapsed = '';
  } catch {}
  try {
    if (localStorage.getItem('qso-contents-collapsed') === 'true') document.documentElement.dataset.contentsCollapsed = '';
  } catch {}
</script>
<DefaultHead />
