---
import products from '../../data/docs.json';

const sections = [
  ['applications', 'Applications'],
  ['mcp-servers', 'MCP Servers'],
  ['libraries', 'Libraries'],
  ['tools', 'Tools'],
];
---
{sections.map(([section, title]) => (
  <>
    <h2 id={section}>{title}</h2>
    <table>
      <thead><tr><th>Product</th><th>What it is</th><th>Version</th></tr></thead>
      <tbody>
        {products.filter((product) => product.section === section)
          .toSorted((a, b) => a.repo.localeCompare(b.repo))
          .map((product) => (
            <tr>
              <td><a href={`/${product.section}/${product.repo}/`}>{product.repo}</a></td>
              <td>{product.description}</td>
              <td><a href={`https://github.com/qso-graph/${product.repo}/releases/tag/${encodeURIComponent(product.tag)}`}>{product.tag}</a></td>
            </tr>
          ))}
      </tbody>
    </table>
  </>
))}
